{
  "schema": "dualyrics.template/1",
  "id": "glass",
  "name": {
    "en": "Glass",
    "fa": "شیشه‌ای"
  },
  "description": {
    "en": "Frosted glass panel: smoky tint, thin light rim and soft depth. Uses real blur-behind when Windows allows it.",
    "fa": "پنل شیشه‌ی مات: رنگ دودی، لبه‌ی روشن باریک و سایه‌ی نرم؛ اگر ویندوز اجازه بدهد پشتش واقعاً تار می‌شود."
  },
  "builtin": true,
  "based_on": null,
  "scale": {
    "mode": "screen",
    "reference_height": 1080
  },
  "layout": {
    "translation_position": "below",
    "mirror_for_rtl": true
  },
  "container": {
    "background": {
      "color": "#1E293B",
      "opacity": 0.74,
      "gradient": {
        "angle": 90,
        "stops": [
          {
            "offset": 0,
            "color": "#2B3A50"
          },
          {
            "offset": 1,
            "color": "#0F172A"
          }
        ]
      }
    },
    "blur": {
      "mode": "acrylic",
      "strength": 18,
      "noise": 0.03,
      "sheen": 0.1
    },
    "padding": {
      "x": 26,
      "y": 16
    },
    "corner_radius": 18,
    "border": {
      "width": 1,
      "color": "#FFFFFF",
      "opacity": 0.22
